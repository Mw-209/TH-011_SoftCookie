DATABASE_URL="postgresql://postgres:postgres@localhost:5432/event_registration_db?schema=public"
SESSION_COOKIE_NAME="event_sys_session"
SESSION_TTL_HOURS=24
SEED_DEMO_DATA="true"
# Required before `npm run prisma:seed`. The seed script rejects the literal
# "change-me" on purpose, so replace it with a real value kept out of Git
# (see SDS 2.4 Credential Safety Rule). Never commit the real value.
DEMO_USER_PASSWORD="change-me"
CORS_ORIGIN="http://localhost:5173"
NODE_ENV="development"
PORT=3000
